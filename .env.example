# ============================================
# Contentine Create — Environment Variables
# Copy to .env.local (frontend) and backend/.env
# ============================================

# --- Auth0 ---
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=xxxxxx
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.contentine.ai
AUTH0_CLIENT_SECRET=xxxxxx

# --- Backend API ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- Database (backend/.env) ---
DB_HOST=localhost
DB_NAME=contentine_create
DB_USER=root
DB_PASS=

# --- LLM APIs (backend/.env) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxx
OPENAI_API_KEY=sk-xxxxxx

# --- Image Generation (backend/.env) ---
DALLE_API_KEY=sk-xxxxxx

# --- Stripe (backend/.env) ---
STRIPE_SECRET_KEY=sk_test_xxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxx

# --- Stock Media (backend/.env) ---
PEXELS_API_KEY=xxxxxx
PIXABAY_API_KEY=xxxxxx

# --- Stock Media APIs ---
FREESOUND_API_KEY=xxxxxx

# --- D-ID API for Pro Avatars ---
DID_API_KEY=xxxxxx

# --- Stripe Connect ---
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxx

# --- Enterprise Contact ---
ENTERPRISE_CONTACT_EMAIL=sales@contentine.ai

# --- App ---
APP_ENV=development
APP_URL=http://localhost:3000
