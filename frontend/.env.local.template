# =========================================================================
# Contentine Create -- Frontend Environment Variables
# =========================================================================
# Copy to: frontend/.env.local
# These are PUBLIC values (prefixed NEXT_PUBLIC_) -- safe for client-side.
# ALL secret keys are stored server-side in admin_config.php or database.
#
# CRITICAL: These values are BAKED INTO the JavaScript at build time.
# If .env.local is missing or has placeholder values when you run
# `npm run build`, Auth0 login WILL break in production.

# Auth0
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-auth0-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.your-domain.com

# Backend API (no trailing slash)
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Stripe (Publishable Key only -- secret stays in admin_config.php)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_xxxxxx
